# Expert Agent MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Private key for signing x402 payments (64 characters hex without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Optional: NANDA facilitator URL (default: http://localhost:3000)
FACILITATOR_URL=http://localhost:3000

# Optional: Server configuration
PORT=3002
HOST=localhost