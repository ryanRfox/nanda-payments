# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
NP_DB_NAME=nanda_points
MONGODB_MAX_CONNECTIONS=10

# ACID transaction support (requires MongoDB replica set in production)
# Dev mode: false (standalone MongoDB, fast, no ACID)
# Prod mode: true (replica set required, ACID guarantees)
MONGODB_USE_TRANSACTIONS=false

# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development
CORS_ORIGINS=*

# NANDA Points Configuration
NP_CURRENCY=NP
NP_SCALE=2
DEFAULT_BALANCE_MINOR=100000 # 100.00 NANDA Points (NP)

# Security
SESSION_EXPIRATION_MINUTES=30
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100