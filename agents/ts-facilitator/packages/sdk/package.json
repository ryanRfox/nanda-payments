{
  "name": "@nanda/sdk",
  "version": "1.0.0",
  "description": "NANDA SDK - JavaScript client for NANDA Facilitator x402 payments",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nanda",
    "x402",
    "payment",
    "sdk",
    "client",
    "typescript",
    "facilitator"
  ],
  "author": "NANDA",
  "license": "MIT",
  "dependencies": {
    "x402": "^0.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "eslint": "^9.11.1",
    "@eslint/js": "^9.11.1",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "prettier": "^3.3.3"
  },
  "peerDependencies": {
    "@nanda/facilitator": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}