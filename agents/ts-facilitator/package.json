{
  "name": "@nanda/ts-facilitator-workspace",
  "version": "1.0.0",
  "description": "NANDA TypeScript x402 Facilitator - Monorepo workspace",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "cd packages/facilitator && npm run dev",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "type-check": "npm run type-check --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "install-deps": "npm install"
  },
  "keywords": [
    "x402",
    "payment",
    "facilitator",
    "nanda",
    "typescript",
    "monorepo"
  ],
  "author": "NANDA",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  }
}