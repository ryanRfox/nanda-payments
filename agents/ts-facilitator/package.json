{
  "name": "@nanda/ts-facilitator-workspace",
  "version": "1.0.0",
  "description": "NANDA TypeScript x402 Facilitator - Monorepo workspace",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @nanda/facilitator dev",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "install-deps": "pnpm install --frozen-lockfile"
  },
  "keywords": [
    "x402",
    "payment",
    "facilitator",
    "nanda",
    "typescript",
    "monorepo"
  ],
  "author": "NANDA",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}